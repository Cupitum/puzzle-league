# Puzzle League browser-only Phase 2 configuration (all values are PUBLIC).
# Copy to .env.local only when necessary. Unset/blank derives from Vite mode:
#   development => local; test => test; production => production.
# For a production build VITE_APP_STAGE must be blank or production.
VITE_APP_STAGE=

# FUTURE, Phase 3+ only (not wired up or required in Phase 2):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# NEVER put service_role, sb_secret_*, JWT secrets, database passwords,
# access tokens, private keys or admin credentials into VITE_ variables.
# No real credential is needed for any Phase 2 command.
