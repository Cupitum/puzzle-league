# Browser-visible PUBLIC values only. Copy to git-ignored .env.local.
# Local Supabase in the same Ubuntu VM: http://127.0.0.1:54321
# Leave these blank in this template; fill local .env.local manually.
VITE_APP_STAGE=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never enter service_role/sb_secret, database passwords, JWT signing keys or
# private authorization tokens in VITE_ values. Android requires HTTPS host.
